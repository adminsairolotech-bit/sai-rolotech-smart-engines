{
  "autoMemory": {
    "enabled": true,
    "maxTokens": 100000,
    "saveInterval": 10
  },
  "context": {
    "maxTokens": 150000,
    "pruneThreshold": 0.8
  },
  "dangerouslySkipPermrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": ".claude\\hooks\\mnemon\\prime.sh",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": ".claude\\hooks\\mnemon\\stop.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": ".claude\\hooks\\mnemon\\user_prompt.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "Bash": true,
    "Edit": true,
    "Glob": true,
    "Grep": true,
    "Read": true,
    "WebFetch": true,
    "WebSearch": true,
    "Write": true
  },
  "session": {
    "autoCommit": true,
    "backupEnabled": true,
    "commitInterval": 5
  }
}
