{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixpkgs": ["#unstable"],
          "apt": ["nginx"]
        },
        "build": {
          "cmds": ["cp -r . /var/www/html", "mv /var/www/html/nginx.conf /etc/nginx/conf.d/default.conf"]
        }
      }
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
