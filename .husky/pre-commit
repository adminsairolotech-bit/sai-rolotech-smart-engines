#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run pre-commit checks (file hygiene only) — skip if pre-commit missing
if command -v python3 >/dev/null 2>&1; then
  python3 -m pre_commit run --all-files 2>/dev/null || true
elif command -v python >/dev/null 2>&1; then
  python -m pre_commit run --all-files 2>/dev/null || true
fi
exit 0
