# SAI RoloTech - Railway Deployment
FROM node:20-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# Copy everything
COPY . .

# Build CRM-2 frontend (outside workspace, needs own install)
RUN cd crm-2 && pnpm install && pnpm build

# Copy frontend dist to api-server public folder
RUN mkdir -p artifacts/api-server/dist && cp -r crm-2/dist artifacts/api-server/dist/public

# Build API server
RUN cd artifacts/api-server && pnpm install && pnpm run build

# Production image
FROM node:20-alpine AS runner

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

COPY --from=builder /app/artifacts/api-server/dist ./dist

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

CMD ["node", "dist/index.cjs"]
